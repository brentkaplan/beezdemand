dat <- apt_full[apt_full$id \%in\% keep, ]
fit3 <- fit_demand_tmb(dat, y_var = "y", x_var = "x", id_var = "id",
                       equation = "exponential", factors = "gender")
get_demand_param_emms(fit3, param = "alpha")
}

